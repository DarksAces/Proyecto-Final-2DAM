<UserControl x:Class="Jovi3DReview.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Jovi3DReview.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Splash / Branding -->
        <Border Grid.Column="0" Background="{StaticResource JoviPrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="JOVI 3D" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="REVIEW SYSTEM" FontSize="14" FontWeight="Bold" Foreground="White" Opacity="0.7" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="Revisión de Modelos" Foreground="White" Opacity="0.9" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Rectangle Width="1" Height="16" Fill="White" Opacity="0.3"/>
                    <TextBlock Text="Gestión Rápida" Foreground="White" Opacity="0.9" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right Login Form -->
        <Grid Grid.Column="1" Background="White">
            <StackPanel VerticalAlignment="Center" Margin="80,0">
                <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,0,0,20" Foreground="{StaticResource JoviPrimaryBrush}"/>
                <TextBlock Text="Bienvenido" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Inicia sesión para continuar" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,48" Opacity="0.7"/>

                <!-- Email -->
                <TextBlock Text="Correo Electrónico" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,8"/>
                <TextBox x:Name="txtEmail"
                         Height="48"
                         Padding="12"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         BorderBrush="#E2E8F0"
                         BorderThickness="1"
                         Margin="0,0,0,24">
                     <TextBox.Resources>
                         <Style TargetType="Border">
                             <Setter Property="CornerRadius" Value="8"/>
                         </Style>
                     </TextBox.Resources>
                </TextBox>

                <!-- Password -->
                <TextBlock Text="Contraseña" FontWeight="SemiBold" Foreground="#64748b" Margin="0,0,0,8"/>
                <PasswordBox x:Name="txtPassword"
                             Height="48"
                             Padding="12"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#E2E8F0"
                             BorderThickness="1"
                             Margin="0,0,0,12">
                     <PasswordBox.Resources>
                         <Style TargetType="Border">
                             <Setter Property="CornerRadius" Value="8"/>
                         </Style>
                     </PasswordBox.Resources>
                </PasswordBox>


                <!-- Forgot Password Link -->
                <TextBlock Text="¿Olvidaste tu contraseña?" 
                            HorizontalAlignment="Right" 
                            FontSize="13" 
                            Foreground="{StaticResource JoviPrimaryBrush}" 
                            Cursor="Hand" 
                            FontWeight="SemiBold"
                            Margin="0,0,0,32"/>

                <!-- Login Button -->
                <Button Content="INICIAR SESIÓN" 
                        Height="50" 
                        Click="Login_Click"
                        Background="{StaticResource JoviPrimaryBrush}" 
                        BorderBrush="{StaticResource JoviPrimaryBrush}"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="4" Color="#FFF31621" Opacity="0.4"/>
                    </Button.Effect>
                </Button>
                
                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="¿No tienes cuenta?" Foreground="#64748b"/>
                    <TextBlock Text="Contacta al soporte" Foreground="{StaticResource JoviPrimaryBrush}" FontWeight="Bold" Margin="8,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
