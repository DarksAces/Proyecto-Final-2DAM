<UserControl x:Class="Jovi3DReview.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Jovi3DReview.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000">
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Content -->
        </Grid.RowDefinitions>

        <!-- HEADER (Sticky Top) -->
        <Border Grid.Row="0" Background="{DynamicResource ARteBackgroundLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <TextBlock Text="{DynamicResource StrRevisionModelos}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Search Bar (Center) -->
                <Border Grid.Column="1" Margin="40,0" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12" Height="40" MaxWidth="480" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextSecondaryBrush}" Width="20" Height="20" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="{DynamicResource StrBuscarHint}" materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Margin="8,0" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </Border>

                <!-- Actions Right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Width="40" Height="40" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0" Click="Notification_Click">
                        <Grid>
                            <materialDesign:PackIcon Kind="BellOutline" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource ARtePrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                        </Grid>
                    </Button>
                    <Button Width="40" Height="40" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="Help_Click">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1" Padding="32" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Headings & Filters -->
                <Grid Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel>
                        <TextBlock Text="{DynamicResource StrModelosPendientes}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="HeaderCountText" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{DynamicResource StrHay}"/>
                            <Run Text="{Binding TotalPendingCount}" FontWeight="Bold"/>
                            <Run Text="{DynamicResource StrObrasEsperando}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Filter Pills -->
                    <Border Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12" Padding="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <!-- Refresh Button -->
                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                    Command="{Binding RefreshDataCommand}"
                                    Width="32" Height="32" Margin="4,0,8,0"
                                    ToolTip="{DynamicResource StrRefrescar}">
                                <materialDesign:PackIcon Kind="Refresh" Foreground="{StaticResource ARtePrimaryBrush}"/>
                            </Button>
                            
                            <Separator Style="{StaticResource MaterialDesignLightSeparator}" Margin="0,4,8,4"/>

                            <!-- Filter Buttons with x:Name -->
                            <Button x:Name="FilterPending" Content="{DynamicResource StrPendientes}" Style="{StaticResource FilterPillButtonActive}" Margin="0,0,4,0" Click="Filter_Click"/>
                            <Button x:Name="FilterApproved" Content="{DynamicResource StrAprobados}" Style="{StaticResource FilterPillButton}" Margin="0,0,4,0" Click="Filter_Click"/>
                            <Button x:Name="FilterDenied" Content="{DynamicResource StrRechazados}" Style="{StaticResource FilterPillButton}" Margin="0,0,4,0" Click="Filter_Click"/>
                            <Button x:Name="FilterAll" Content="{DynamicResource StrTodos}" Style="{StaticResource FilterPillButton}" Click="Filter_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- GRID CARDS -->
                <ItemsControl x:Name="ModelsList" ItemsSource="{Binding Models}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="340" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,24,24" Effect="{StaticResource MaterialDesignShadowDepth1}">
                                <StackPanel>
                                    <!-- Image Area -->
                                    <Grid Height="190" ClipToBounds="True">
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,340,190" RadiusX="12" RadiusY="12"/> 
                                        </Grid.Clip>
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill" VerticalAlignment="Center"/>
                                        
                                        <!-- Category Tag -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="{StaticResource ARteSecondaryBrush}" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding Type, TargetNullValue=PLASTILINA}" FontSize="10" FontWeight="Black" Foreground="White"/>
                                        </Border>

                                        <!-- Visibility Button -->
                                        <Button Background="#E6FFFFFF" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Click="Card_Click" BorderThickness="0">
                                            <materialDesign:PackIcon Kind="Eye" Foreground="{StaticResource ARtePrimaryBrush}" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>

                                    <!-- Content Area -->
                                    <StackPanel Margin="20">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ReviewsDateDisplay}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                        </Grid>
                                        
                                        <!-- School/Author -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                            <materialDesign:PackIcon Kind="School" Foreground="{StaticResource JoviBlueBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Author}" FontSize="14" Foreground="#64748b"/>
                                        </StackPanel>

                                        <!-- Status Indicator or Buttons -->
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*"/>
                                                             <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Margin="0,0,6,0" Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" Foreground="{DynamicResource SuccessForegroundBrush}" FontWeight="Bold" Height="40" materialDesign:ButtonAssist.CornerRadius="8" Click="Approve_Click" Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="CheckCircle" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource StrAceptar}" VerticalAlignment="Center" FontSize="12"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="1" Margin="6,0,0,0" Background="{DynamicResource ErrorBackgroundBrush}" BorderBrush="{DynamicResource ErrorBorderBrush}" Foreground="{DynamicResource ErrorForegroundBrush}" FontWeight="Bold" Height="40" materialDesign:ButtonAssist.CornerRadius="8" Click="Reject_Click" Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon Kind="Cancel" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{DynamicResource StrRechazar}" VerticalAlignment="Center" FontSize="12"/>
                                                            </StackPanel>
                                                        </Button>
                                                        
                                                        <!-- Status Text if Not Pending -->
                                                        <Border Grid.ColumnSpan="2" Background="{DynamicResource SurfaceVariantBrush}" CornerRadius="8" Height="40" Visibility="{Binding IsNotPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding StatusDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Pagination (Footer) -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,24,0,0">
                   <Grid>
                       <TextBlock x:Name="PaginationText" Text="{Binding PaginationText}" VerticalAlignment="Center" Foreground="#64748b" FontSize="14"/>
                       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                           <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Anterior" Height="32" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" Foreground="#64748b"/>
                           <Button Content="1" Style="{StaticResource MaterialDesignFlatButton}" Background="{StaticResource ARtePrimaryBrush}" Foreground="White" Height="32" Width="32" Padding="0" Margin="0,0,8,0"/>
                           <Button Content="2" Style="{StaticResource MaterialDesignOutlinedButton}" Height="32" Width="32" Padding="0" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" Foreground="#64748b"/>
                           <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Siguiente" Height="32" BorderBrush="{StaticResource BorderBrush}" Foreground="#64748b"/>
                       </StackPanel>
                   </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
