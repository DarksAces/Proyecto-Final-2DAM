<UserControl x:Class="Jovi3DReview.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Jovi3DReview.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Splash / Branding -->
        <Border Grid.Column="0" Background="{StaticResource ARtePrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/ARte.png" Width="180" Height="180" Margin="0,0,0,32"/>
                <TextBlock Text="ARte" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="{DynamicResource StrRevisionSistema}" FontSize="14" FontWeight="Bold" Foreground="White" Opacity="0.7" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="{DynamicResource StrRevisionModelos}" Foreground="White" Opacity="0.9" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Rectangle Width="1" Height="16" Fill="White" Opacity="0.3"/>
                    <TextBlock Text="{DynamicResource StrGestionRapida}" Foreground="White" Opacity="0.9" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right Login Form -->
        <Grid Grid.Column="1" Background="{DynamicResource ARteBackgroundLightBrush}">
            <StackPanel VerticalAlignment="Center" Margin="80,0" MaxWidth="450">
                <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Height="4" Margin="0,0,0,32" Foreground="{StaticResource ARtePrimaryBrush}" Background="Transparent"/>
                
                <TextBlock Text="{DynamicResource StrBienvenido}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource StrIniciaSesion}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,48" Opacity="0.8"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage" Text="{Binding ErrorMessage}" Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,16" FontWeight="SemiBold"/>

                <!-- Email -->
                <TextBox x:Name="EmailBox"
                         materialDesign:HintAssist.Hint="{DynamicResource StrEmailHint}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="50"
                         FontSize="14"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,24"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Password -->
                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="{DynamicResource StrPasswordHint}"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Height="50"
                             FontSize="14"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,12"
                             BorderBrush="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>

                <!-- Forgot Password Link -->
                <TextBlock Text="{DynamicResource StrOlvidastePassword}" 
                            HorizontalAlignment="Right" 
                            FontSize="13" 
                            Foreground="{StaticResource ARtePrimaryBrush}" 
                            Cursor="Hand" 
                            FontWeight="SemiBold"
                            Margin="0,0,0,32"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton"
                        Content="{DynamicResource StrIniciarSesionBtn}" 
                        Height="50" 
                        Click="Login_Click"
                        IsEnabled="{Binding IsButtonEnabled}"
                        Background="{StaticResource ARtePrimaryBrush}" 
                        BorderBrush="{StaticResource ARtePrimaryBrush}"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="8"/>
                
                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="{DynamicResource StrNoTienesCuenta}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{DynamicResource StrContactaSoporte}" Foreground="{StaticResource ARtePrimaryBrush}" FontWeight="Bold" Margin="8,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
