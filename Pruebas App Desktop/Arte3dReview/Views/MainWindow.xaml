<Window x:Class="Jovi3DReview.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Jovi3DReview.Views"
        mc:Ignorable="d"
        Title="ARte Review" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource MaterialDesignPaper}"
        FontFamily="Segoe UI">

    <Grid Background="{DynamicResource ARteBackgroundLightBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource ARteBackgroundLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0" Margin="32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/ARte.png" Width="64" Height="64" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ARte" FontSize="26" FontWeight="Black" Foreground="{StaticResource ARtePrimaryBrush}"/>
                            <TextBlock Text="REVIEW" FontSize="12" FontWeight="Bold" Foreground="{StaticResource ARteSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- MENU -->
                <StackPanel Grid.Row="1" Margin="16,0">
                    <TextBlock Text="{DynamicResource StrMenuPrincipal}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,0,0,12"/>
                    
                    <RadioButton x:Name="DashboardRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.ViewDashboardOutline}" Content="{DynamicResource StrDashboard}" IsChecked="True" Checked="Dashboard_Checked" PreviewMouseLeftButtonDown="Dashboard_Checked"/>

                    <RadioButton x:Name="LibraryRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.CubeOutline}" Content="{DynamicResource StrBiblioteca}" Margin="0,4" Checked="Biblioteca_Checked"/>

                    <RadioButton x:Name="UsersRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.AccountGroupOutline}" Content="{DynamicResource StrUsuarios}" Margin="0,4" Checked="Usuarios_Checked"/>

                    <RadioButton x:Name="ReportsRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.ChartBoxOutline}" Content="{DynamicResource StrReportes}" Margin="0,4" Checked="Reportes_Checked"/>

                    <TextBlock Text="{DynamicResource StrSoporte}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="16,32,0,12"/>
                    
                    <RadioButton x:Name="SettingsRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.CogOutline}" Content="{DynamicResource StrConfiguracion}" Margin="0,4" Checked="Configuracion_Checked"/>

                    <RadioButton x:Name="HelpRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.HelpCircleOutline}" Content="{DynamicResource StrAyuda}" Margin="0,4" Checked="Ayuda_Checked"/>
                </StackPanel>

                <!-- USER PROFILE MINI -->
                <Border Grid.Row="2" Margin="16,0,16,32" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="12" Padding="12" MouseLeftButtonDown="Profile_Click" Cursor="Hand" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource ARteSecondaryBrush}">
                            <TextBlock Text="U" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock x:Name="CurrentUserName" Text="Usuario" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="CurrentUserRole" Text="{DynamicResource StrAdministrador}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        
                        <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT AREA -->
        <Border Grid.Column="1" Background="{DynamicResource ARteBackgroundLightBrush}" CornerRadius="24,0,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0">
            <ContentControl x:Name="ActiveContent" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>
