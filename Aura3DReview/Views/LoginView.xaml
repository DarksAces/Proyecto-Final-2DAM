<UserControl x:Class="Jovi3DReview.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Jovi3DReview.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Splash / Branding -->
        <Border Grid.Column="0" Background="{StaticResource JoviPrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="24" Width="100" Height="100" Margin="0,0,0,24">
                    <TextBlock Text="J" FontSize="72" FontWeight="Black" Foreground="{StaticResource JoviPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="JOVI 3D" FontSize="48" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="REVIEW SYSTEM" FontSize="14" FontWeight="Bold" Foreground="White" Opacity="0.7" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="Revisión de Modelos" Foreground="White" Opacity="0.9" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Rectangle Width="1" Height="16" Fill="White" Opacity="0.3"/>
                    <TextBlock Text="Gestión Rápida" Foreground="White" Opacity="0.9" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Right Login Form -->
        <Grid Grid.Column="1" Background="White">
            <StackPanel VerticalAlignment="Center" Margin="80,0" MaxWidth="450">
                <ProgressBar x:Name="LoadingProgressBar" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,0,0,32" Foreground="{StaticResource JoviPrimaryBrush}" Background="Transparent"/>
                
                <TextBlock Text="Bienvenido" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="Inicia sesión para continuar" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,48" Opacity="0.8"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorMessage" Visibility="Collapsed" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,16" FontWeight="SemiBold"/>

                <!-- Email -->
                <TextBox x:Name="EmailBox"
                         materialDesign:HintAssist.Hint="Correo Electrónico"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="50"
                         FontSize="14"
                         Padding="12,0"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,24"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <!-- Password -->
                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Contraseña"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             Height="50"
                             FontSize="14"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,12"
                             BorderBrush="{StaticResource BorderBrush}"/>

                <!-- Forgot Password Link -->
                <TextBlock Text="¿Olvidaste tu contraseña?" 
                            HorizontalAlignment="Right" 
                            FontSize="13" 
                            Foreground="{StaticResource JoviPrimaryBrush}" 
                            Cursor="Hand" 
                            FontWeight="SemiBold"
                            Margin="0,0,0,32"/>

                <!-- Login Button -->
                <Button x:Name="LoginButton"
                        Content="INICIAR SESIÓN" 
                        Height="50" 
                        Click="Login_Click"
                        Background="{StaticResource JoviPrimaryBrush}" 
                        BorderBrush="{StaticResource JoviPrimaryBrush}"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand"
                        materialDesign:ButtonAssist.CornerRadius="8"/>
                
                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,60,0,0">
                    <TextBlock Text="¿No tienes cuenta?" Foreground="#64748b"/>
                    <TextBlock Text="Contacta al soporte" Foreground="{StaticResource JoviPrimaryBrush}" FontWeight="Bold" Margin="8,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
