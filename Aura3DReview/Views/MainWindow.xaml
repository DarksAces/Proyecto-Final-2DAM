<Window x:Class="Aura3DReview.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Aura3DReview.Views"
        mc:Ignorable="d"
        Title="Aura 3D Review" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource MaterialDesignPaper}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource AuraBackgroundLightBrush}" BorderThickness="0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LOGO -->
                <StackPanel Grid.Row="0" Margin="32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <!-- Simplified AURA Logo Representation -->
                        <Border Background="{StaticResource AuraPrimaryBrush}" CornerRadius="12" Width="48" Height="48">
                            <TextBlock Text="A" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="AURA" FontSize="26" FontWeight="Black" Foreground="{StaticResource AuraPrimaryBrush}"/>
                            <TextBlock Text="3D REVIEW" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- MENU -->
                <StackPanel Grid.Row="1" Margin="16,0">
                    <TextBlock Text="MENU PRINCIPAL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,12"/>
                    
                    <RadioButton x:Name="DashboardRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.ViewDashboardOutline}" Content="Dashboard" IsChecked="True" Checked="Dashboard_Checked"/>

                    <RadioButton x:Name="LibraryRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.CubeOutline}" Content="Biblioteca" Margin="0,4" Checked="Biblioteca_Checked"/>

                    <RadioButton x:Name="UsersRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.AccountGroupOutline}" Content="Usuarios" Margin="0,4" Checked="Usuarios_Checked"/>

                    <RadioButton x:Name="ReportsRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.ChartBoxOutline}" Content="Reportes" Margin="0,4" Checked="Reportes_Checked"/>

                    <TextBlock Text="SOPORTE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,32,0,12"/>
                    
                    <RadioButton x:Name="SettingsRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.CogOutline}" Content="Configuración" Margin="0,4" Checked="Configuracion_Checked"/>

                    <RadioButton x:Name="HelpRadio" Style="{StaticResource SidebarRadioButton}" Tag="{x:Static materialDesign:PackIconKind.HelpCircleOutline}" Content="Ayuda" Margin="0,4" Checked="Ayuda_Checked"/>
                </StackPanel>

                <!-- USER PROFILE MINI -->
                <Border Grid.Row="2" Margin="16,0,16,32" Background="White" CornerRadius="12" Padding="12" MouseLeftButtonDown="Profile_Click" Cursor="Hand" Effect="{StaticResource MaterialDesignShadowDepth1}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{StaticResource AuraBlueBrush}">
                            <TextBlock Text="AA" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                            <TextBlock x:Name="CurrentUserName" Text="Aura Admin" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="CurrentUserRole" Text="Supervisor" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        
                        <materialDesign:PackIcon Grid.Column="2" Kind="ChevronRight" Foreground="Gray" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- CONTENT AREA -->
        <Border Grid.Column="1" Background="{StaticResource AuraBackgroundLightBrush}" CornerRadius="24,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" Margin="0">
            <ContentControl x:Name="ActiveContent" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>
